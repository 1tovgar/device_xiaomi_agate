soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "hardware/google/pixel/power-libperfmgr",
        "hardware/lineage/interfaces/power-libperfmgr",
        "hardware/google/pixel/pixelstats",
        "vendor/xiaomi/agate",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_mms_interface",
    interfaces: [
        "vendor.mediatek.hardware.mms@1.0::IMms",
        "vendor.mediatek.hardware.mms@1.1::IMms",
        "vendor.mediatek.hardware.mms@1.2::IMms",
        "vendor.mediatek.hardware.mms@1.3::IMms",
        "vendor.mediatek.hardware.mms@1.4::IMms",
        "vendor.mediatek.hardware.mms@1.5::IMms",
        "vendor.mediatek.hardware.mms@1.6::IMms",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_mmagent_interface",
    interfaces: [
        "vendor.mediatek.hardware.mmagent@1.0::IMMAgent",
        "vendor.mediatek.hardware.mmagent@1.1::IMMAgent",
    ],
}

cc_library_shared {
    name: "android.hardware.audio@7.0-util.agate",
    vendor: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "audio_util/CoreUtils.cpp",
    ],
    shared_libs: [
        "android.hardware.audio.common@7.0",
        "android.hardware.audio.common@7.0-enums",
        "android.hardware.audio.common@7.0-util",
        "android.hardware.audio.common-util",
        "android.hardware.audio@7.0",
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    export_shared_lib_headers: [
        "android.hardware.audio.common-util",
    ],
    header_libs: [
        "libaudio_system_headers",
        "libhardware_headers",
    ],
    export_include_dirs: [
        "audio_util/include",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-DMAJOR_VERSION=7",
        "-DMINOR_VERSION=0",
        "-include common/all-versions/VersionMacro.h",
    ],
}

cc_library_shared {
    name: "libgpud_shim",
    vendor: true,
    srcs: ["shims/gpud_shim.c"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// The camera libraries ship OpenCL kernels precompiled for the old r32p1 driver.
// This ICD front-end converts them for the r49p1 driver while loading them and
// forwards everything else to the stock ICD loader (libOpenCL_real.so).
cc_library_shared {
    name: "libOpenCL",
    vendor: true,
    compile_multilib: "64",
    srcs: [
        "shims/opencl/opencl_shim.c",
        "shims/opencl/stubs.S",
    ],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-mno-outline-atomics",
    ],
}
