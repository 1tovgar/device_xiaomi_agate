# Lineage Health HAL needs to read/write power supply sysfs nodes for
# fast charge control (/sys/class/power_supply/usb/fastcharge_mode) and
# charging control (/sys/class/power_supply/battery/input_suspend).
allow hal_lineage_health_default sysfs_power_supply:dir r_dir_perms;
allow hal_lineage_health_default sysfs_power_supply:file rw_file_perms;
