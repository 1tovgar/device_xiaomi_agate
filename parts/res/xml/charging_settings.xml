<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/charging_title">

    <ListPreference
        android:defaultValue="0"
        android:entries="@array/charging_profile_entries"
        android:entryValues="@array/charging_profile_values"
        android:key="charging_profile"
        android:summary="%s"
        android:title="@string/charging_profile_title" />

    <Preference
        android:selectable="false"
        android:summary="@string/charging_profile_footer" />

</PreferenceScreen>
